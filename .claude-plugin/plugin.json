{
  "name": "wiro-ai",
  "displayName": "Wiro AI",
  "version": "1.0.0",
  "description": "Run image, video, audio and LLM models on Wiro AI from Claude Code",
  "author": {
    "name": "Wiro AI",
    "email": "support@wiro.ai",
    "url": "https://wiro.ai"
  },
  "homepage": "https://wiro.ai/docs/wiro-mcp-server",
  "repository": "https://github.com/wiroai/Wiro-Plugin",
  "license": "MIT",
  "keywords": ["wiro", "ai-models", "image-generation", "video-generation", "text-to-speech", "llm", "mcp"],
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Wiro API key",
      "description": "API key of your Wiro project. If the project uses signature-based auth, enter API_KEY:API_SECRET. Create a project at https://wiro.ai/panel/project/new",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "wiro": {
      "type": "http",
      "url": "https://mcp.wiro.ai/v1",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}"
      }
    }
  }
}
